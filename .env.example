# .env.example - Copy this to .env and fill in actual values

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile
MODEL_FALLBACKS=llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct,qwen/qwen3-32b,llama-3.1-8b-instant

# Database Configuration
DATABASE_URL=clinic.db
DATABASE_TIMEOUT=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Security
SECRET_KEY=your_secret_key_for_jwt_tokens_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMITING_ENABLED=True
RATE_LIMIT_PER_MINUTE=30
REQUEST_LOGGING_ENABLED=True

# Performance
MAX_REQUEST_SIZE=10485760
QUERY_TIMEOUT=60
DATABASE_POOL_SIZE=10
CONNECTION_POOL_RECYCLE=3600

# Optional: Error Tracking (Sentry)
SENTRY_DSN=

# Optional: Monitoring (Prometheus)
PROMETHEUS_ENABLED=False
